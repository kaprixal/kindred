# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit real keys.

# Required for live Shopify data (Shopify Dev Dashboard: an app with Catalog API access).
# Leave blank to run with offline sample products.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional. Checkout calls need the buyer's public IP. Locally the app looks it up
# automatically; set it here only if that lookup is blocked on your network.
# BUYER_IP=

# Optional. UCP agent profile URL. Defaults to Shopify's hosted example profile.
# UCP_AGENT_PROFILE=
